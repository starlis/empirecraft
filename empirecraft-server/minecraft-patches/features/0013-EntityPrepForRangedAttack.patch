From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aikar <aikar@aikar.co>
Date: Mon, 25 Jun 2018 22:55:42 -0400
Subject: [PATCH] EntityPrepForRangedAttack


diff --git a/net/minecraft/world/entity/ai/goal/RangedAttackGoal.java b/net/minecraft/world/entity/ai/goal/RangedAttackGoal.java
index d9a167d28cf4c41532d8d7c721a8beb862bbd2ff..7e8a55896e8db6ef07c8a2f9c463894ae2846778 100644
--- a/net/minecraft/world/entity/ai/goal/RangedAttackGoal.java
+++ b/net/minecraft/world/entity/ai/goal/RangedAttackGoal.java
@@ -80,9 +80,18 @@ public class RangedAttackGoal extends Goal {
             this.seeTime = 0;
         }
 
-        if (!(targetDistSqr > this.attackRadiusSqr) && this.seeTime >= 5) {
+        // EMC start - EntityPrepForRangedAttack
+        //if (!(targetDistSqr > this.attackRadiusSqr) && this.seeTime >= 5) {
+        boolean isInRange = targetDistSqr <= (double) this.attackRadiusSqr;
+        boolean readyforAttack = this.seeTime >= 5;
+        com.empireminecraft.empirecraft.event.entity.EntityPrepForRangedAttack event = new com.empireminecraft.empirecraft.event.entity.EntityPrepForRangedAttack((com.destroystokyo.paper.entity.RangedEntity) mob.getBukkitEntity(), this.target.getBukkitEntity(), readyforAttack, !isInRange, this.seeTime);
+        if (!event.callEvent()) {
+            return;
+        }
+        if (event.shouldStop() && !event.shouldMoveNear()) {
             this.mob.getNavigation().stop();
-        } else {
+        } else if (event.shouldMoveNear()) {
+            // EMC end - EntityPrepForRangedAttack
             this.mob.getNavigation().moveTo(this.target, this.speedModifier);
         }
 
diff --git a/net/minecraft/world/entity/ai/goal/RangedBowAttackGoal.java b/net/minecraft/world/entity/ai/goal/RangedBowAttackGoal.java
index 13a815c753f01088af53ba63c07ee9293ca0b440..2a569f039177beb5c9bc70fc3151cb49b8305229 100644
--- a/net/minecraft/world/entity/ai/goal/RangedBowAttackGoal.java
+++ b/net/minecraft/world/entity/ai/goal/RangedBowAttackGoal.java
@@ -83,10 +83,19 @@ public class RangedBowAttackGoal<T extends Monster & RangedAttackMob> extends Go
                 this.seeTime--;
             }
 
-            if (!(targetDistSqr > this.attackRadiusSqr) && this.seeTime >= 20) {
+            // EMC start - EntityPrepForRangedAttack
+            //if (!(targetDistSqr > this.attackRadiusSqr) && this.seeTime >= 20) {
+            boolean isInRange = targetDistSqr <= (double) this.attackRadiusSqr;
+            boolean readyforAttack = this.seeTime >= 20;
+            com.empireminecraft.empirecraft.event.entity.EntityPrepForRangedAttack event = new com.empireminecraft.empirecraft.event.entity.EntityPrepForRangedAttack((com.destroystokyo.paper.entity.RangedEntity) mob.getBukkitEntity(), target.getBukkitEntity(), readyforAttack, !isInRange, this.seeTime);
+            if (!event.callEvent()) {
+                    return;
+                }
+            if (event.shouldStop() && !event.shouldMoveNear()) {
                 this.mob.getNavigation().stop();
                 this.strafingTime++;
-            } else {
+            } else if (event.shouldMoveNear()){
+                // EMC end - EntityPrepForRangedAttack
                 this.mob.getNavigation().moveTo(target, this.speedModifier);
                 this.strafingTime = -1;
             }
